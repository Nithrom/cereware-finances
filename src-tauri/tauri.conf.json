{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CereWare Finances",
  "version": "0.2.2",
  "identifier": "com.cereware.finances",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CereWare Finances",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CereWare",
    "shortDescription": "Finanzas personales y de autónomo",
    "android": {
      "minSdkVersion": 28
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NEJDNjlCQ0M3N0FDNzcKUldSM3JIZk1tOFpMcHltbXk0SmZjby9UWmUvMDcxc0lYVEJ3aHZuTC81cDhjUHlNOGdwaFE3Z2MK",
      "endpoints": [
        "https://cerezuela-software.com/cwf/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
